family=development
builder=fluent
adapter=object
importer=mixed
sink=console,file
logPath=../data/pipeline-variant20.txt
outputPath=../output/system-rules.log
databasePath=../output/system-rules.sqlite
documentPath=../output/system-rules.jsonl
minSeverity=Info
format=plain
filters=severity,age,duplicates
maxAgeMinutes=60
notifications=push
bufferCapacity=4
referenceTimeUtc=2026-10-07T12:00:00Z
decorators=buffer,retry,timing
batchSize=7
retryAttempts=3
rule={"op":"and","children":[{"op":"severity","value":"Warning"},{"op":"not","child":{"op":"message","value":"healthcheck"}}]}
