family=development
builder=fluent
adapter=object
importer=mixed
sink=console,file
logPath=../data/pipeline-variant20.txt
outputPath=../output/system-pull.log
databasePath=../output/system-pull.sqlite
documentPath=../output/system-pull.jsonl
minSeverity=Info
format=plain
filters=severity,age,duplicates
maxAgeMinutes=60
notifications=pull
bufferCapacity=4
referenceTimeUtc=2026-10-07T12:00:00Z
decorators=buffer,retry,timing
batchSize=7
retryAttempts=3
