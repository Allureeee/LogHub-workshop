family=development
builder=fluent
adapter=object
importer=mixed
sink=console,file
logPath=../data/pipeline-variant20.txt
outputPath=../output/system-development.log
databasePath=../output/system-development.sqlite
documentPath=../output/system-development.jsonl
minSeverity=Info
format=plain
filters=severity,age,duplicates
maxAgeMinutes=60
notifications=push
bufferCapacity=4
referenceTimeUtc=2026-10-07T12:00:00Z
decorators=buffer,retry,timing
batchSize=7
retryAttempts=3
